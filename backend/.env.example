PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rme_klinik_gigi

JWT_SECRET=ubah-ini-menjadi-string-panjang-dan-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:5173

APP_NAME=RME Klinik Gigi

# Email reset password (contoh Gmail: host smtp.gmail.com, port 587, secure false, pass pakai App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# QR absensi (isi teks yang sama harus ter-encode di QR cetak). Ganti di production.
ATTENDANCE_QR_CHECKIN=RME_ABS_CHECKIN_DEV
ATTENDANCE_QR_CHECKOUT=RME_ABS_CHECKOUT_DEV

LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=20
